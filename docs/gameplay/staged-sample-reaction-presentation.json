{
  "schemaVersion": "2.1",
  "feature": "staged-sample-reaction-presentation",
  "stations": [
    "workbench",
    "fume-hood"
  ],
  "interactionSequence": [
    "pick-up-source-with-E",
    "place-on-station-tray-with-E",
    "load-vessel-from-staged-tray-with-E",
    "observe-reaction-close-view",
    "collect-product-separately",
    "clean-up-recorded-remaining-mixture-at-sink",
    "repeat-or-choose-another-experiment"
  ],
  "physicalRules": {
    "directHandToVesselAllowed": false,
    "reactionWhileHeldAllowed": false,
    "reactionWhenPlacedOnTrayAllowed": false,
    "remoteTrayToVesselAllowed": false,
    "failedLoadPreservesStagedSample": true,
    "independentTrayPerStation": true,
    "staleInventoryBatchLoadAllowed": false
  },
  "reactionPresentation": {
    "targetFieldOfViewDegrees": 42,
    "showsBalancedEquation": true,
    "showsConditionSummary": true,
    "showsCatalystSummary": true,
    "showsObservation": true,
    "skipKeys": [
      "Space",
      "E",
      "Escape"
    ],
    "reducedMotionMovesCamera": false,
    "restoresOriginalCameraTransform": true,
    "closeViewOffsetFromTargetMetres": [
      0.24,
      0.21,
      0.4
    ],
    "targetHeightAboveVesselRootMetres": 0.09,
    "pauseFreezesCameraEasing": true,
    "midViewReducedMotionRestoresCamera": true
  },
  "vesselVisuals": {
    "colourSource": "measured-input-colours-then-committed-outcome-display-colour",
    "concentrationAffectsOpacity": true,
    "precipitateCloudsLiquidAndSettles": true,
    "gasBubblesRiseAndDisappearAtSurface": true,
    "effectsStopAfterBoundedReactionDuration": true,
    "cleanupClearsParticlesAndSediment": true,
    "reducedMotionUsesImmediateColourAndLowerEmission": true,
    "visualsChangeChemistryOrSafety": false,
    "hazardAloneEmitsFumes": false,
    "gasColourRequiresReviewedOutcomeData": true,
    "colourlessGasUsesBubblesAndSafetyHud": true,
    "thermalHazeMinimumTemperatureC": 90,
    "thermalHazeDuringGasOutcome": false,
    "meshShape": "inner-envelope-of-approved-0.18m-flask-with-static-meniscus",
    "fillSource": "outcome-volume-integrated-against-inner-profile",
    "colourDurationSource": "estimated-completion-seconds-minimum-0.75",
    "bubbleDiameterMetres": [
      0.0015,
      0.004
    ],
    "particleContainment": "liquid-surface-bottom-and-vessel-radius",
    "sedimentPersistsAfterCollection": true,
    "independentMeshesMaterialsTimersAndBuffers": true,
    "pauseUsesScaledTime": true,
    "fireOrExplosionAuthorizedByCurrentOutcomes": false
  },
  "runtimeAssertions": [
    "handOnlyReactionBlocked",
    "remoteVesselOperationBlocked",
    "samplePlacementFlowVerified",
    "reactionEquationPresentationVerified",
    "reactionCameraVerified",
    "staleBatchLoadBlockedVerified",
    "conditionCommitVerified",
    "onceOnlyCollectionVerified"
  ],
  "lifecycle": {
    "reactionsPerVesselBetweenCleanups": 1,
    "collectionOnce": true,
    "loadHeatDiluteUseSameCommitPath": true,
    "consequencesAppliedOnce": true,
    "recordedInputsRetainedAfterCollection": true,
    "changesAfterCommitRequireCleanup": true,
    "remainingMassMeaning": "Signed recorded input grams minus collected primary product grams; solvent and byproduct identities are not fully modelled.",
    "cleanupClearsBothVessels": true
  }
}
